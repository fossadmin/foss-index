---
import DecisionBrief from '../components/DecisionBrief.astro';
import ContributeRoutes from '../components/ContributeRoutes.astro';
import decisionBriefs from '../data/decision-briefs.json';
import contributeRoutes from '../data/contribute-routes.json';
import PlatformSupport from '../components/PlatformSupport.astro';
import platformSupport from '../data/platform-support.json';
import { getCollection, render } from 'astro:content';
import CatalogLayout from '../layouts/CatalogLayout.astro';
import { catalog, browseSlugForCategory, slugify } from '../lib/catalog';
import licenses from '../data/licenses.json';
import setupPrompts from '../data/setup-prompts.json';
import SetupPrompt from '../components/SetupPrompt.astro';
import { buildSetupPrompts } from '../lib/setup-prompt-text.js';
export async function getStaticPaths() { return (await getCollection('docs')).map(entry => ({ params: { slug: entry.id }, props: { entry } })); }
const { entry } = Astro.props;
const { Content } = await render(entry);
const { tools } = await catalog();
const tool = tools.find(t => t.id === entry.id);
const licInfo = tool?.license ? (licenses as Record<string, { summary: string; url: string }>)[tool.license] : undefined;
const data = entry.data;
const promptRecord = (setupPrompts as Record<string, any>)[entry.id];
const brief = (decisionBriefs as Record<string, any>)[entry.id];
const contribute = (contributeRoutes as Record<string, any>)[entry.id];
const setupPromptList = promptRecord ? buildSetupPrompts({ title: data.title, body: entry.body ?? '', record: promptRecord }) : [];
const funding = data.funding ?? {};
const shot = data.screenshot;
const serviceCreditHref = `${import.meta.env.BASE_URL}credits/#tool-${slugify(data.title)}`;
const links = [
  { label: 'GitHub Sponsors', url: funding.githubSponsors }, { label: 'Open Collective', url: funding.openCollective },
  { label: 'Polar', url: funding.polar }, { label: 'Liberapay', url: funding.liberapay }, ...(funding.custom ?? []),
].filter(l => l.url);
---
<CatalogLayout title={data.title} description={data.description} active={data.category ? browseSlugForCategory(data.category) : ''}>
  <article class="detail">
    <a class="back-link" href={import.meta.env.BASE_URL}>← All tools</a>
    <header class="detail-heading">
      <p class="eyebrow">{tool?.broadCategory ?? 'The project'}</p>
      <h1>{data.title}</h1><p class="lede">{data.description}</p>
      {tool && <div class="detail-meta"><div class="license-wrap"><details class="license-info"><summary class="license">{tool.license}</summary></details><div class="license-note">{licInfo ? <><p>{licInfo.summary}</p><a href={licInfo.url}>Read the full license ↗</a></> : <p>No plain-language summary is recorded for this license yet. Check the <a href={data.repository}>source repository</a> for the full text.</p>}<p class="license-fine">Plain-language summary, not legal advice.</p></div></div><a class="source-link" href={data.repository}>Source code ↗</a><a class="source-link support-shortcut" href="#project-support">Support this project ↓</a><button class="save-toggle save-pill" data-save-toggle data-tool-id={entry.id} type="button" hidden aria-pressed="false"><svg class="bookmark" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"><path d="M6.5 3.5h11V21L12 16.4 6.5 21z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg><span class="save-label">Save</span></button></div>}
    </header>
    {brief && <DecisionBrief {...brief} />}
    {tool && <p class="privacy-note">Tags: {tool.tags.map((tag, i) => <>{i > 0 && ", "}<a href={`${import.meta.env.BASE_URL}tag/${slugify(tag)}/`}>{tag}</a></>)}</p>}
    {(platformSupport as Record<string, any>)[entry.id] && <PlatformSupport record={(platformSupport as Record<string, any>)[entry.id]} />}
    {tool?.release?.version && (tool.release.changelog ? <details class="changelog"><summary>Release notes / {tool.release.version}</summary>
      {tool.release.manual ? <p class="release-date">Version checked by hand{tool.release.checkedOn ? ` on ${tool.release.checkedOn}` : ""}. Snapshot from the included release data, not a live check.</p> : <p class="release-date">{tool.release.date ? `Released ${tool.release.date.slice(0,10)}. ` : ""}Snapshot from the included release data, not a live check.</p>}
      <p class="changelog-body">{tool.release.changelog}</p>
      {tool.release.url && <a href={tool.release.url}>{new URL(tool.release.url).hostname === "github.com" ? "Read the full release notes on GitHub" : "Read the full release notes"} ↗</a>}
    </details> : <div class="changelog">
      <strong>Recorded release / {tool.release.version}</strong>
      {tool.release.manual ? <p class="release-date">Version checked by hand{tool.release.checkedOn ? ` on ${tool.release.checkedOn}` : ""}. Snapshot from the included release data, not a live check.</p> : <p class="release-date">{tool.release.date ? `Released ${tool.release.date.slice(0,10)}. ` : ""}Snapshot from the included release data, not a live check.</p>}
      <p>No release-notes excerpt is recorded here.</p>
      {tool.release.url && <a href={tool.release.url}>Open the project's release source ↗</a>}
    </div>)}
    {shot && <figure class="shot" data-shot><img src={`${import.meta.env.BASE_URL}screenshots/${shot.src}`} alt={shot.alt} width={shot.width} height={shot.height} style={shot.height > shot.width ? "width:auto;max-width:100%;max-height:560px;margin-inline:auto" : undefined} decoding="async" /><figcaption>{shot.commons
      ? <>Screenshot by {shot.credit} on <a href={shot.sourceUrl}>Wikimedia Commons ↗</a>{shot.license ? <> ({shot.license})</> : null}. {shot.captionNote}</>
      : shot.terminal
      ? <>Rendered terminal output of {shot.credit}{shot.version ? ` ${shot.version}` : ''}, not a literal screen capture. {shot.captionNote}</>
      : shot.own
      ? <>Our own screenshot of {shot.credit}{shot.version ? ` ${shot.version}` : ''}. {shot.captionNote ?? "Empty default state, not a production setup."}</>
      : <>Official screenshot from <a href={shot.sourceUrl}>{shot.credit} ↗</a>{shot.license ? <> ({shot.license})</> : null}. {shot.captionNote ?? 'Demo data, not our install.'}</>}{data.icon && <> The tool icon is the project's own mark.</>} <a href={serviceCreditHref}>Image credits</a>.</figcaption></figure>}
    {!shot && data.icon && <p class="privacy-note"><a href={serviceCreditHref}>Image credits</a></p>}
    <div class="prose"><Content />{setupPromptList.map(p => <SetupPrompt {...p} />)}</div>
    {tool && <aside class="support-panel" id="project-support" tabindex="-1"><p class="eyebrow">Keep open source going</p><h2>Support this project</h2>{links.length ? <><p>Support goes directly to the maintainers through their own channels. We do not take a cut.</p><ul>{links.map(l => <li><a href={l.url}>{l.label} ↗</a></li>)}</ul></> : <p>No direct funding link is recorded for this tool yet. Check its <a href={data.repository}>source repository</a> for ways to contribute.</p>}{contribute && <ContributeRoutes {...contribute} />}</aside>}
    {data.managedHosting && <p class="managed-line">Want help running it? <a href="https://fossadmin.com">Ask FOSSadmin about hosting and maintenance ↗</a></p>}
  </article>
</CatalogLayout>

<script>
  import { mountSetupPrompts } from "../lib/setup-prompt.js";
  (() => {
    const fig = document.querySelector('[data-shot]');
    const qs = [...document.querySelectorAll('.prose h2')].find((h) => h.textContent.trim().toLowerCase() === 'quick start');
    if (fig && qs) qs.before(fig);
  })();
  document.querySelectorAll('.prose h2').forEach((h2) => {
    if (h2.textContent.trim().toLowerCase() !== 'quick start') return;
    const lead = [];
    const sections = [];
    let node = h2.nextElementSibling;
    while (node && node.tagName !== 'H2') {
      if (node.tagName === 'H3') sections.push({ title: node.textContent.trim(), heading: node, nodes: [] });
      else if (sections.length) sections[sections.length - 1].nodes.push(node);
      else lead.push(node);
      node = node.nextElementSibling;
    }
    if (sections.length < 2) return;
    const base = h2.id || 'quick-start';
    const wrap = document.createElement('div');
    wrap.className = 'qs-tabs';
    const tablist = document.createElement('div');
    tablist.className = 'qs-tablist';
    tablist.setAttribute('role', 'tablist');
    tablist.setAttribute('aria-label', 'Quick start platforms');
    const tabs = [];
    const panels = [];
    const osNote = document.createElement('p');
    osNote.className = 'qs-os-note';
    osNote.hidden = true;
    const winMacOnly = (t) => /windows|macos/i.test(t) && !/linux/i.test(t);
    function select(idx, focus, save) {
      tabs.forEach((t, i) => {
        const on = i === idx;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
        panels[i].hidden = !on;
      });
      const title = sections[idx].title;
      if (winMacOnly(title)) {
        const plats = [/windows/i.test(title) ? 'Windows' : '', /macos/i.test(title) ? 'macOS' : ''].filter(Boolean).join(' and ');
        osNote.textContent = `You can use open-source apps on ${plats} too. For an open-source operating system, consider Linux.`;
        osNote.hidden = false;
      } else {
        osNote.hidden = true;
      }
      if (save) { try { localStorage.setItem('foss-index:qs-os', title); } catch (e) {} }
      if (focus) tabs[idx].focus();
    }
    sections.forEach((sec, i) => {
      const tab = document.createElement('button');
      tab.type = 'button';
      tab.className = 'qs-tab';
      tab.id = base + '-tab-' + i;
      tab.setAttribute('role', 'tab');
      tab.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
      tab.tabIndex = i === 0 ? 0 : -1;
      tab.textContent = sec.title;
      const panel = document.createElement('div');
      panel.className = 'qs-panel';
      panel.id = base + '-panel-' + i;
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('aria-labelledby', tab.id);
      panel.tabIndex = 0;
      panel.hidden = i !== 0;
      sec.nodes.forEach((n) => panel.appendChild(n));
      tab.setAttribute('aria-controls', panel.id);
      tab.addEventListener('click', () => select(i, false, true));
      tabs.push(tab);
      panels.push(panel);
      tablist.appendChild(tab);
      sec.heading.remove();
    });
    tablist.addEventListener('keydown', (e) => {
      const cur = tabs.indexOf(document.activeElement);
      if (cur < 0) return;
      let next = null;
      if (e.key === 'ArrowRight') next = (cur + 1) % tabs.length;
      else if (e.key === 'ArrowLeft') next = (cur - 1 + tabs.length) % tabs.length;
      else if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = tabs.length - 1;
      if (next === null) return;
      e.preventDefault();
      select(next, true, true);
    });
    wrap.appendChild(tablist);
    wrap.appendChild(osNote);
    panels.forEach((pn) => wrap.appendChild(pn));
    (lead.length ? lead[lead.length - 1] : h2).after(wrap);
    const linuxFirst = sections.findIndex((s) => /^linux\b/i.test(s.title));
    const anyLinux = sections.findIndex((s) => /linux/i.test(s.title));
    let initial = linuxFirst >= 0 ? linuxFirst : anyLinux >= 0 ? anyLinux : 0;
    try {
      const saved = localStorage.getItem('foss-index:qs-os');
      const savedIdx = saved ? sections.findIndex((s) => s.title === saved) : -1;
      if (savedIdx >= 0) initial = savedIdx;
    } catch (e) {}
    if (initial !== 0) select(initial, false, false);
  });
  mountSetupPrompts();
</script>

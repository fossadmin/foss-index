---
import CatalogLayout from '../layouts/CatalogLayout.astro';
const base = import.meta.env.BASE_URL;
---
<CatalogLayout
  title="Watch the tour"
  description="A 76-second tour of the FOSS Index: find open-source software, check platforms and licenses, and support the projects behind the tools."
  active=""
  ogImage="https://index.fossadmin.com/media/tour-poster.jpg"
  ogImageWidth="1280"
  ogImageHeight="720"
  ogImageType="image/jpeg"
>
  <article class="detail">
    <header class="detail-head">
      <p class="eyebrow">The directory / Tour</p>
      <h1>Watch the tour</h1>
      <p class="lede">Quick tour around the Index: finding a tool, checking platforms and licenses, saving tools for later, and supporting the projects behind them. Captions available.</p>
    </header>
    <div class="tour-page-video">
      <video controls preload="none" playsinline data-tour-video poster={`${base}media/tour-poster.jpg`} src={`${base}media/tour.mp4`} data-src-mobile={`${base}media/tour-mobile.mp4`} data-src-desktop={`${base}media/tour.mp4`} data-poster-mobile={`${base}media/tour-poster-mobile.jpg`} data-poster-desktop={`${base}media/tour-poster.jpg`}>
        <track kind="captions" srclang="en" label="English" src={`${base}media/tour.vtt`} />
      </video>
      <div class="tour-cut tour-cut-page" role="group" aria-label="Video format"><button type="button" data-tour-cut="mobile" aria-pressed="false">Mobile</button><button type="button" data-tour-cut="desktop" aria-pressed="true">Desktop</button></div>
    </div>
    <p class="tour-page-note">The video is our own recording of this site; narration is synthetic, not a person. Mobile and desktop cuts of the same 76-second tour; captions are shared. <a href={`${base}media/tour.mp4`}>Download the desktop MP4 ↗</a></p>
  </article>
</CatalogLayout>

<script>
  import { initTourPlayer } from '../lib/tour-player';
  const root = document.querySelector('.tour-page-video');
  if (root) initTourPlayer(root)?.pickAuto();
</script>

<style>
  .tour-page-video { margin: 1.5rem 0 0.8rem; }
  .tour-page-video video { width: 100%; max-width: 880px; border: 1px solid var(--line, #c9c5b6); border-radius: 6px; display: block; background: #000; }
  .tour-page-video video[src*="tour-mobile"] { max-width: 420px; }
  .tour-cut-page { margin-top: 8px; }
  .tour-page-note { font-size: 0.84rem; opacity: 0.75; max-width: 60ch; }
</style>

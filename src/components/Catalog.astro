---
import platformSupport from '../data/platform-support.json';
import { platformSearch } from '../lib/taxonomy.mjs';
import alternativeSearch from '../data/search-alternatives.json';
import CatalogLayout from '../layouts/CatalogLayout.astro';
import featuredData from '../data/featured.json';
import { catalog, browseSlugForCategory, exploreLede } from '../lib/catalog';
const { category, group, tag, platform } = Astro.props;
const { tools, categories, groups, tags, platforms } = await catalog();
const selectedCategory = categories.find(c => c.slug === category);
const selectedGroup = groups.find(g => g.slug === group);
const selectedTag = tags.find(t => t.slug === tag);
const selectedPlatform = platforms.find(p => p.slug === platform);
const selected = selectedPlatform ?? selectedTag ?? selectedGroup ?? selectedCategory;
const toolPlatforms = (t: (typeof tools)[number]) => [...(t.platformRecord?.platforms ?? []), ...(t.platformRecord?.server?.platforms ?? []), ...(t.platformRecord?.clients ?? [])];
const visible = selectedPlatform ? tools.filter(t => toolPlatforms(t).some(row => row.name === selectedPlatform.name)) : selectedTag ? tools.filter(t => t.tags.includes(selectedTag.name)) : selectedGroup ? tools.filter(t => selectedGroup.categories.includes(t.data.category!)) : selectedCategory ? tools.filter(t => t.data.category === selectedCategory.name) : tools;
const active = selectedGroup?.slug ?? (selectedCategory ? browseSlugForCategory(selectedCategory.name) : 'all');
// Search snippets: each taxonomy page describes itself instead of sharing the
// homepage tagline, and tag pages get titles distinct from same-named
// category pages. Text mirrors the on-page lede and card facts.
const pageTitle = selectedTag
  ? `Tools tagged ${selectedTag.name}`
  : selectedGroup
    ? `Browse ${selectedGroup.name}`
    : (selected?.name ?? 'Discover open source.');
const pageDescription = selectedPlatform
  ? `Explore listings with checked ${selectedPlatform.name} apps, clients or tools. Check each listing for browser-only, service-host and compatibility limits.`
  : selectedTag
    ? `Open-source tools tagged ${selectedTag.name}, with licenses, platform support and project-support links.`
    : selectedGroup
      ? `Browse open-source software for ${selectedGroup.name.toLowerCase()}, with licenses, platform support and project-support links.`
      : selectedCategory
        ? (exploreLede[selectedCategory.name] ?? `Explore ${selectedCategory.name.toLowerCase()} open-source software, with licenses, platform support and project-support links.`)
        : `Explore ${tools.length} open-source tools, with setup guides and project-support links.`;
// Featured projects: free editorial picks listed first in the all-tools view,
// labeled FEATURED on their regular card. SPONSORED is reserved for future paid
// placements, which always list before FEATURED entries.
const featuredIds = [...featuredData.picks, featuredData.random];
for (const id of featuredIds) {
  if (!tools.some(t => t.id === id)) throw new Error(`featured.json: unknown listing id "${id}"`);
}
const featuredRank = new Map(featuredIds.map((id, i) => [id, i]));
const ordered = !selected ? [...visible].sort((a, b) => (featuredRank.get(a.id) ?? 1e9) - (featuredRank.get(b.id) ?? 1e9)) : visible;
// Card measurement: this week's featured tools plus the previous week's
// cohort after it returns to normal positions, compared week over week.
const previousIds = (featuredData.previous ?? []).filter((id: string) => !featuredRank.has(id));
const nextIds = (featuredData.next ?? []).filter((id: string) => !featuredRank.has(id));
for (const id of [...previousIds, ...nextIds]) {
  if (!tools.some(t => t.id === id)) throw new Error(`featured.json: unknown listing id "${id}"`);
}
const cardPlacement = new Map<string, string>(featuredIds.map(id => [id, 'featured']));
for (const id of [...previousIds, ...nextIds]) cardPlacement.set(id, 'regular');
const measureAttrs = (id: string) => !selected && cardPlacement.has(id) ? { 'data-card-placement': cardPlacement.get(id) } : {};
---
<CatalogLayout title={pageTitle} description={pageDescription} active={active}>
  <section class="catalog-heading">
    <p class="eyebrow">The directory / {selected?.name ?? 'All tools'}</p>
    <h1>{selected?.name ?? <>Discover open source.<br /><span>Support the projects.</span></>}</h1>
    <p class="lede">{selectedPlatform ? `Explore listings with checked ${selectedPlatform.name} apps, clients or tools. Check each listing for browser-only, service-host and compatibility limits. Client support does not mean the server runs on that platform.` : selected ? (exploreLede[selected.name] ?? `Explore ${selected.name.toLowerCase()} open-source software.`) : 'Explore open-source software, with setup guides and project-support links.'}</p>
    {!selected && <p class="tour-line"><button class="tour-open" type="button" data-tour-open><svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M10 8.5v7l5.5-3.5z" fill="currentColor"/></svg>New here? Watch the tour</button><a class="tour-open recent-link" href={`${import.meta.env.BASE_URL}recent/`} data-recent-link>Recently added <span aria-hidden="true">&rarr;</span></a></p>}
  </section>
  {!selected && <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var cards = document.querySelectorAll('[data-card-placement]');
      if (!cards.length) return;
      var viewed = new Set(), timers = new Map();
      function send(name, el) {
        if (typeof window.umami === 'undefined' || typeof window.umami.track !== 'function') return;
        window.umami.track(name, { placement: el.getAttribute('data-card-placement'), tool: el.getAttribute('data-tool-id') });
      }
      function clearTimer(el) { var t = timers.get(el); if (t) { clearTimeout(t); timers.delete(el); } }
      document.addEventListener('visibilitychange', function () { if (document.hidden) { timers.forEach(function (t) { clearTimeout(t); }); timers.clear(); } });
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          var el = entry.target, k = el.getAttribute('data-tool-id');
          if (viewed.has(k)) { clearTimer(el); return; }
          if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
            if (timers.has(el)) return;
            timers.set(el, setTimeout(function () {
              timers.delete(el);
              if (document.hidden || viewed.has(k)) return;
              viewed.add(k); send('card-view', el); io.unobserve(el);
            }, 1000));
          } else { clearTimer(el); }
        });
      }, { threshold: [0, 0.5] });
      cards.forEach(function (el) { io.observe(el); });
    });
  </script>}
  {!selected && <dialog class="tour-modal" data-tour-modal aria-label="FOSS Index tour video">
    <div class="tour-bar"><a class="tour-title" href={`${import.meta.env.BASE_URL}tour/`}>FOSS Index tour</a><div class="tour-cut" role="group" aria-label="Video format"><button type="button" data-tour-cut="mobile" aria-pressed="false">Mobile</button><button type="button" data-tour-cut="desktop" aria-pressed="true">Desktop</button></div><button class="tour-close" type="button" data-tour-close aria-label="Close the tour video"><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></button></div>
    <video controls preload="none" playsinline data-tour-video poster={`${import.meta.env.BASE_URL}media/tour-poster.jpg`} src={`${import.meta.env.BASE_URL}media/tour.mp4`} data-src-mobile={`${import.meta.env.BASE_URL}media/tour-mobile.mp4`} data-src-desktop={`${import.meta.env.BASE_URL}media/tour.mp4`} data-poster-mobile={`${import.meta.env.BASE_URL}media/tour-poster-mobile.jpg`} data-poster-desktop={`${import.meta.env.BASE_URL}media/tour-poster.jpg`}>
      <track kind="captions" srclang="en" label="English" src={`${import.meta.env.BASE_URL}media/tour.vtt`} />
    </video>
  </dialog>}

  <section aria-label="Tools" data-catalog>
    <div class="search-row" data-search-ui>
      <label class="search-field"><span class="search-prompt" aria-hidden="true">&gt;</span><span class="sr-only">Search {selected?.name ?? 'all tools'}</span><input type="search" placeholder="Find a tool, platform, tag, or alternative…" data-search autocomplete="off" /></label>
      <span class="search-hint">/ to search</span>
    </div>
    <p class="privacy-note" hidden data-alternative-note role="status" aria-live="polite"></p>
    <div class="list-heading"><h2 data-list-heading>{selected?.name ?? 'All tools'}</h2><div class="list-tools"><div class="view-toggle" role="group" aria-label="Listing layout" data-view-toggle><button type="button" data-view-option="compact" aria-pressed="true"><svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>Compact</button><button type="button" data-view-option="detail" aria-pressed="false"><svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"><rect x="4" y="4" width="7" height="7" rx="1" fill="none" stroke="currentColor" stroke-width="1.7"/><rect x="13" y="4" width="7" height="7" rx="1" fill="none" stroke="currentColor" stroke-width="1.7"/><rect x="4" y="13" width="7" height="7" rx="1" fill="none" stroke="currentColor" stroke-width="1.7"/><rect x="13" y="13" width="7" height="7" rx="1" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>Detail</button></div><button class="random-pick" data-random type="button" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="16 3 21 3 21 8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><line x1="4" y1="20" x2="21" y2="3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><polyline points="21 16 21 21 16 21" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><line x1="15" y1="15" x2="21" y2="21" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><line x1="4" y1="4" x2="9" y2="9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>Surprise me</button><p role="status" aria-live="polite" data-result-count>{visible.length} {visible.length === 1 ? 'tool' : 'tools'}</p></div></div>
    <ul class="tool-list" data-view="compact" data-tool-list>
      {ordered.map((tool, toolIndex) => <li class:list={["tool-item", {"no-mark": !(tool.data.icon || tool.data.iconLink || tool.data.mark)}]} data-tool data-tool-id={tool.id} {...measureAttrs(tool.id)} data-alternative-names={JSON.stringify((alternativeSearch as Record<string, { names: string[] }>)[tool.id]?.names ?? [])} data-search-text={`${tool.data.title} ${tool.data.description} ${tool.broadCategory} ${tool.tags.join(" ")} ${platformSearch((platformSupport as Record<string, any>)[tool.id])} ${tool.license}`.toLowerCase()}>
        <a class="tool-row" href={tool.href} data-umami-event="card-click" data-umami-event-tool={tool.id} data-umami-event-placement={featuredRank.has(tool.id) ? 'featured' : 'regular'}>
          <span class:list={["tool-shot", {"no-shot": !tool.data.screenshot}]} aria-hidden="true">{tool.data.screenshot ? <img src={`${import.meta.env.BASE_URL}screenshots/${tool.data.screenshot.src}`} alt="" width={tool.data.screenshot.width} height={tool.data.screenshot.height} loading="lazy" decoding="async" /> : <span class="no-shot-text">No screenshot yet</span>}</span>
          {tool.data.icon && !tool.data.iconLink ? (
            <span class="tool-mark tool-icon" aria-hidden="true">
              <img class:list={[{ 'icon-light': tool.data.iconDark, 'icon-tile': tool.data.iconTile }]} src={`${import.meta.env.BASE_URL}icons/${tool.data.icon}`} alt="" width="40" height="40" loading={toolIndex < 12 ? 'eager' : 'lazy'} decoding="async" />
              {tool.data.iconDark && <img class="icon-dark" src={`${import.meta.env.BASE_URL}icons/${tool.data.iconDark}`} alt="" width="40" height="40" loading={toolIndex < 12 ? 'eager' : 'lazy'} decoding="async" />}
            </span>
          ) : (tool.data.iconLink || tool.data.mark) ? (
            <span class:list={["tool-mark", {"linked-icon-placeholder": tool.data.iconLink}]} aria-hidden="true">{tool.data.iconLink ? "" : tool.data.mark}</span>
          ) : <span class="tool-mark tool-mark-blank" aria-hidden="true"></span>}
          <span class="tool-copy"><span class="tool-name">{tool.data.title}{featuredRank.has(tool.id) && <span class="tool-flag">Featured</span>}</span><span class="tool-purpose">{tool.data.description}</span><span class="tool-category">{tool.broadCategory}{tool.tags.some(tag => tag !== tool.broadCategory) && <> · {tool.tags.filter(tag => tag !== tool.broadCategory).join(", ")}</>}</span></span>
          <span class="tool-meta"><span class="license">{tool.license}</span><span class="version">{tool.release?.version ?? 'Release not recorded'}{tool.release?.date && <span class="version-date" title="Recorded release date"> · {tool.release.date.slice(0, 10)}</span>}</span></span>
          <span class="row-arrow" aria-hidden="true">↗</span>
        </a>
        {tool.data.iconLink && tool.data.icon && <a class="tool-mark tool-icon project-icon-link" href={tool.data.iconLink} aria-label={`${tool.data.title} official project website`} data-umami-event="outbound-click" data-umami-event-link="website" data-umami-event-tool={tool.id}><img src={`${import.meta.env.BASE_URL}icons/${tool.data.icon}`} alt="" width="40" height="40" loading="lazy" decoding="async" /></a>}
        <a class="catalog-support" href={`${tool.href}#project-support`} aria-label={`Support ${tool.data.title}`}>Support project <span aria-hidden="true">↗</span></a>
        <button class="save-toggle" data-save-toggle data-tool-id={tool.id} type="button" hidden aria-pressed="false" aria-label={`Save ${tool.data.title}`}>
          <svg class="bookmark" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M6.5 3.5h11V21L12 16.4 6.5 21z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
        </button>
      </li>)}
    </ul>
    <p class="empty-state" hidden data-empty>No tools match that search. Try another name, purpose, or license.</p>
    <p class="empty-state" hidden data-empty-saved>No saved tools yet. Tap the bookmark on any tool to keep it here. Saves live only in this browser: no account, nothing uploaded, and clearing browser data removes them.</p>
    <div class="catalog-note"><span class="eyebrow">A starting point, not a ranking.</span><p>Read the license. Check the release notes. If a project helps you, help it keep going.</p><a href={`${import.meta.env.BASE_URL}about/`}>How this index works <span aria-hidden="true">→</span></a></div>
    {!selected && <p class="managed-line">Want help setting up any of these tools? <a href="https://fossadmin.com">Ask FOSSadmin ↗</a></p>}
  </section>
</CatalogLayout>
<script define:vars={{ toolHrefs: tools.map(t => t.href) }}>
  (function () {
    var btn = document.querySelector('[data-random]');
    if (!btn || !toolHrefs.length) return;
    btn.hidden = false;
    btn.addEventListener('click', function () {
      var pick = toolHrefs[Math.floor(Math.random() * toolHrefs.length)];
      var last = null;
      try { last = sessionStorage.getItem('foss-index:last-random'); } catch (e) {}
      if (toolHrefs.length > 1 && pick === last) {
        pick = toolHrefs[(toolHrefs.indexOf(pick) + 1) % toolHrefs.length];
      }
      try { sessionStorage.setItem('foss-index:last-random', pick); } catch (e) {}
      location.href = pick;
    });
  })();
</script>
<script>
  import { initTourPlayer } from '../lib/tour-player';
  const tourModal = document.querySelector<HTMLDialogElement>('[data-tour-modal]');
  const tourOpen = document.querySelector<HTMLButtonElement>('[data-tour-open]');
  if (tourModal && tourOpen) {
    const video = tourModal.querySelector('video');
    const tour = initTourPlayer(tourModal);
    tourOpen.addEventListener('click', () => { tour?.pickAuto(); tourModal.showModal(); video?.play().catch(() => {}); });
    tourModal.querySelector('[data-tour-close]')?.addEventListener('click', () => tourModal.close());
    tourModal.addEventListener('click', e => { if (e.target === tourModal) tourModal.close(); });
    tourModal.addEventListener('close', () => { video?.pause(); tourOpen.focus(); });
  }
</script>
<script>
  const list = document.querySelector<HTMLElement>('[data-tool-list]');
  const toggle = document.querySelector<HTMLElement>('[data-view-toggle]');
  if (list && toggle) {
    const options = [...toggle.querySelectorAll<HTMLButtonElement>('[data-view-option]')];
    const iconOverlays = [...document.querySelectorAll<HTMLElement>('.project-icon-link')];
    const syncIconOverlays = () => {
      const detail = list.dataset.view === 'detail';
      for (const overlay of iconOverlays) {
        const item = overlay.closest<HTMLElement>('.tool-item');
        const inner = item?.querySelector<HTMLElement>('.tool-row .tool-mark');
        if (!detail || !item || !inner || item.hidden) {
          overlay.style.top = '';
          overlay.style.left = '';
          overlay.removeAttribute('data-icon-placed');
          continue;
        }
        const r = inner.getBoundingClientRect();
        const c = item.getBoundingClientRect();
        overlay.style.top = `${r.top - c.top - item.clientTop}px`;
        overlay.style.left = `${r.left - c.left - item.clientLeft}px`;
        overlay.setAttribute('data-icon-placed', '');
      }
    };
    const setView = (view: string, save: boolean) => {
      list.dataset.view = view;
      options.forEach(o => o.setAttribute('aria-pressed', String(o.dataset.viewOption === view)));
      syncIconOverlays();
      if (save) { try { localStorage.setItem('foss-index:view', view); } catch {} }
    };
    let stored = 'compact';
    try { stored = localStorage.getItem('foss-index:view') === 'detail' ? 'detail' : 'compact'; } catch {}
    setView(stored, false);
    options.forEach(o => o.addEventListener('click', () => setView(o.dataset.viewOption!, true)));
    new ResizeObserver(syncIconOverlays).observe(list);
    window.addEventListener('load', syncIconOverlays);
  }
</script>
<script>
  import { matchTool } from '../lib/search.mjs';
  const input = document.querySelector<HTMLInputElement>('[data-search]');
  const rows = [...document.querySelectorAll<HTMLElement>('[data-tool]')];
  const ui = document.querySelector<HTMLElement>('[data-search-ui]');
  const countEl = document.querySelector<HTMLElement>('[data-result-count]')!;
  const headingEl = document.querySelector<HTMLElement>('[data-list-heading]');
  const emptySearch = document.querySelector<HTMLElement>('[data-empty]')!;
  const emptySaved = document.querySelector<HTMLElement>('[data-empty-saved]');
  const alternativeNote = document.querySelector<HTMLElement>('[data-alternative-note]');
  const alternativeNames = new Map(rows.map(row => [row, JSON.parse(row.dataset.alternativeNames ?? '[]')]));
  const baseHeading = headingEl?.textContent ?? '';
  const savedIds = () => {
    try {
      const v = JSON.parse(localStorage.getItem('foss-index:saved') || '[]');
      return Array.isArray(v) ? v : [];
    } catch { return []; }
  };
  const apply = () => {
    const query = input?.value ?? '';
    const matchedAlternatives = new Set<string>();
    const savedMode = location.hash === '#saved';
    const ids = savedMode ? savedIds() : [];
    let count = 0;
    for (const row of rows) {
      const match = matchTool(row.dataset.searchText!, alternativeNames.get(row)!, query);
      const show = match.matches && (!savedMode || ids.includes(row.dataset.toolId!));
      if (show && match.alternative) matchedAlternatives.add(match.alternative);
      row.hidden = !show;
      if (show) count++;
    }
    if (alternativeNote) {
      alternativeNote.hidden = matchedAlternatives.size === 0;
      alternativeNote.textContent = matchedAlternatives.size ? `Alternatives to explore for ${[...matchedAlternatives].join(', ')}. Features, compatibility and workflows differ.` : '';
    }
    countEl.textContent = savedMode ? `${count} saved` : `${count} ${count === 1 ? 'tool' : 'tools'}`;
    if (headingEl) headingEl.textContent = savedMode ? 'Saved tools' : baseHeading;
    emptySearch.hidden = (savedMode && ids.length === 0) || count !== 0;
    if (emptySaved) emptySaved.hidden = !(savedMode && ids.length === 0);
  };
  if (input && ui) {
    input.addEventListener('input', apply);
    document.addEventListener('keydown', e => {
      if (e.key === '/' && !e.ctrlKey && !e.metaKey && !(e.target instanceof HTMLInputElement) && !(e.target instanceof HTMLTextAreaElement)) { e.preventDefault(); input.focus(); }
    });
  }
  window.addEventListener('hashchange', apply);
  document.addEventListener('foss-index:saved-changed', apply);
  apply();
</script>

---
import platformSupport from '../data/platform-support.json';
import { platformSearch } from '../lib/taxonomy.mjs';
import alternativeSearch from '../data/search-alternatives.json';
import CatalogLayout from '../layouts/CatalogLayout.astro';
import { catalog, browseSlugForCategory, exploreLede } from '../lib/catalog';
const { category, group, tag, platform } = Astro.props;
const { tools, categories, groups, tags, platforms } = await catalog();
const selectedCategory = categories.find(c => c.slug === category);
const selectedGroup = groups.find(g => g.slug === group);
const selectedTag = tags.find(t => t.slug === tag);
const selectedPlatform = platforms.find(p => p.slug === platform);
const selected = selectedPlatform ?? selectedTag ?? selectedGroup ?? selectedCategory;
const visible = selectedPlatform ? tools.filter(t => t.platformRecord?.platforms.some(row => row.name === selectedPlatform.name)) : selectedTag ? tools.filter(t => t.tags.includes(selectedTag.name)) : selectedGroup ? tools.filter(t => selectedGroup.categories.includes(t.data.category!)) : selectedCategory ? tools.filter(t => t.data.category === selectedCategory.name) : tools;
const active = selectedGroup?.slug ?? (selectedCategory ? browseSlugForCategory(selectedCategory.name) : 'all');
---
<CatalogLayout title={selected?.name ?? 'Discover open source.'} active={active}>
  <section class="catalog-heading">
    <p class="eyebrow">The directory / {selected?.name ?? 'All tools'}</p>
    <h1>{selected?.name ?? <>Discover open source.<br /><span>Support the projects.</span></>}</h1>
    <p class="lede">{selectedPlatform ? `Explore listings with checked ${selectedPlatform.name} apps, clients or tools. Check each listing for browser-only, service-host and compatibility limits. Client support does not mean the server runs on that platform.` : selected ? (exploreLede[selected.name] ?? `Explore ${selected.name.toLowerCase()} open-source software.`) : 'Explore open-source software, with setup guides and project-support links.'}</p>
  </section>
  <section aria-label="Tools" data-catalog>
    <div class="search-row" hidden data-search-ui>
      <label class="search-field"><span class="search-prompt" aria-hidden="true">&gt;</span><span class="sr-only">Search {selected?.name ?? 'all tools'}</span><input type="search" placeholder="Find a tool, platform, tag, or alternative…" data-search autocomplete="off" /></label>
      <span class="search-hint">/ to search</span>
    </div>
    <p class="privacy-note" hidden data-alternative-note role="status" aria-live="polite"></p>
    <div class="list-heading"><h2 data-list-heading>{selected?.name ?? 'All tools'}</h2><div class="list-tools"><div class="view-toggle" role="group" aria-label="Listing layout" data-view-toggle hidden><button type="button" data-view-option="compact" aria-pressed="true"><svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>Compact</button><button type="button" data-view-option="detail" aria-pressed="false"><svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"><rect x="4" y="4" width="7" height="7" rx="1" fill="none" stroke="currentColor" stroke-width="1.7"/><rect x="13" y="4" width="7" height="7" rx="1" fill="none" stroke="currentColor" stroke-width="1.7"/><rect x="4" y="13" width="7" height="7" rx="1" fill="none" stroke="currentColor" stroke-width="1.7"/><rect x="13" y="13" width="7" height="7" rx="1" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>Detail</button></div><button class="random-pick" data-random type="button" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="16 3 21 3 21 8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><line x1="4" y1="20" x2="21" y2="3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><polyline points="21 16 21 21 16 21" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><line x1="15" y1="15" x2="21" y2="21" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><line x1="4" y1="4" x2="9" y2="9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>Surprise me</button><p role="status" aria-live="polite" data-result-count>{visible.length} {visible.length === 1 ? 'tool' : 'tools'}</p></div></div>
    <ul class="tool-list" data-view="compact" data-tool-list>
      {visible.map(tool => <li class="tool-item" data-tool data-tool-id={tool.id} data-alternative-names={JSON.stringify((alternativeSearch as Record<string, { names: string[] }>)[tool.id]?.names ?? [])} data-search-text={`${tool.data.title} ${tool.data.description} ${tool.broadCategory} ${tool.tags.join(" ")} ${platformSearch((platformSupport as Record<string, any>)[tool.id])} ${tool.license}`.toLowerCase()}>
        <a class="tool-row" href={tool.href}>
          <span class:list={["tool-shot", {"no-shot": !tool.data.screenshot}]} aria-hidden="true">{tool.data.screenshot ? <img src={`${import.meta.env.BASE_URL}screenshots/${tool.data.screenshot.src}`} alt="" width={tool.data.screenshot.width} height={tool.data.screenshot.height} loading="lazy" decoding="async" /> : <span class="no-shot-text">No screenshot yet</span>}</span>
          {tool.data.icon && !tool.data.iconLink ? (
            <span class="tool-mark tool-icon" aria-hidden="true">
              <img class:list={[{ 'icon-light': tool.data.iconDark, 'icon-tile': tool.data.iconTile }]} src={`${import.meta.env.BASE_URL}icons/${tool.data.icon}`} alt="" width="40" height="40" loading="lazy" decoding="async" />
              {tool.data.iconDark && <img class="icon-dark" src={`${import.meta.env.BASE_URL}icons/${tool.data.iconDark}`} alt="" width="40" height="40" loading="lazy" decoding="async" />}
            </span>
          ) : (
            <span class:list={["tool-mark", {"linked-icon-placeholder": tool.data.iconLink}]} aria-hidden="true">{tool.data.iconLink ? "" : tool.data.mark}</span>
          )}
          <span class="tool-copy"><span class="tool-name">{tool.data.title}</span><span class="tool-purpose">{tool.data.description}</span><span class="tool-category">{tool.broadCategory}{tool.tags.some(tag => tag !== tool.broadCategory) && <> · {tool.tags.filter(tag => tag !== tool.broadCategory).join(", ")}</>}</span></span>
          <span class="tool-meta"><span class="license">{tool.license}</span><span class="version">{tool.release?.version ?? 'Release not recorded'}{tool.release?.date && <span class="version-date" title="Recorded release date"> · {tool.release.date.slice(0, 10)}</span>}</span></span>
          <span class="row-arrow" aria-hidden="true">↗</span>
        </a>
        {tool.data.iconLink && tool.data.icon && <a class="tool-mark tool-icon project-icon-link" href={tool.data.iconLink} aria-label={`${tool.data.title} official project website`}><img src={`${import.meta.env.BASE_URL}icons/${tool.data.icon}`} alt="" width="40" height="40" loading="lazy" decoding="async" /></a>}
        <a class="catalog-support" href={`${tool.href}#project-support`} aria-label={`Support ${tool.data.title}`}>Support project <span aria-hidden="true">↗</span></a>
        <button class="save-toggle" data-save-toggle data-tool-id={tool.id} type="button" hidden aria-pressed="false" aria-label={`Save ${tool.data.title}`}>
          <svg class="bookmark" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M6.5 3.5h11V21L12 16.4 6.5 21z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
        </button>
      </li>)}
    </ul>
    <p class="empty-state" hidden data-empty>No tools match that search. Try another name, purpose, or license.</p>
    <p class="empty-state" hidden data-empty-saved>No saved tools yet. Tap the bookmark on any tool to keep it here. Saves live only in this browser: no account, nothing uploaded, and clearing browser data removes them.</p>
    <div class="catalog-note"><span class="eyebrow">A starting point, not a ranking.</span><p>Read the license. Check the release notes. If a project helps you, help it keep going.</p><a href={`${import.meta.env.BASE_URL}about/`}>How this index works <span aria-hidden="true">→</span></a></div>
  </section>
</CatalogLayout>
<script define:vars={{ toolHrefs: tools.map(t => t.href) }}>
  (function () {
    var btn = document.querySelector('[data-random]');
    if (!btn || !toolHrefs.length) return;
    btn.hidden = false;
    btn.addEventListener('click', function () {
      var pick = toolHrefs[Math.floor(Math.random() * toolHrefs.length)];
      var last = null;
      try { last = sessionStorage.getItem('foss-index:last-random'); } catch (e) {}
      if (toolHrefs.length > 1 && pick === last) {
        pick = toolHrefs[(toolHrefs.indexOf(pick) + 1) % toolHrefs.length];
      }
      try { sessionStorage.setItem('foss-index:last-random', pick); } catch (e) {}
      location.href = pick;
    });
  })();
</script>
<script>
  const list = document.querySelector<HTMLElement>('[data-tool-list]');
  const toggle = document.querySelector<HTMLElement>('[data-view-toggle]');
  if (list && toggle) {
    const options = [...toggle.querySelectorAll<HTMLButtonElement>('[data-view-option]')];
    const iconOverlays = [...document.querySelectorAll<HTMLElement>('.project-icon-link')];
    const syncIconOverlays = () => {
      const detail = list.dataset.view === 'detail';
      for (const overlay of iconOverlays) {
        const item = overlay.closest<HTMLElement>('.tool-item');
        const inner = item?.querySelector<HTMLElement>('.tool-row .tool-mark');
        if (!detail || !item || !inner || item.hidden) {
          overlay.style.top = '';
          overlay.style.left = '';
          overlay.removeAttribute('data-icon-placed');
          continue;
        }
        const r = inner.getBoundingClientRect();
        const c = item.getBoundingClientRect();
        overlay.style.top = `${r.top - c.top - item.clientTop}px`;
        overlay.style.left = `${r.left - c.left - item.clientLeft}px`;
        overlay.setAttribute('data-icon-placed', '');
      }
    };
    const setView = (view: string, save: boolean) => {
      list.dataset.view = view;
      options.forEach(o => o.setAttribute('aria-pressed', String(o.dataset.viewOption === view)));
      syncIconOverlays();
      if (save) { try { localStorage.setItem('foss-index:view', view); } catch {} }
    };
    let stored = 'compact';
    try { stored = localStorage.getItem('foss-index:view') === 'detail' ? 'detail' : 'compact'; } catch {}
    setView(stored, false);
    toggle.hidden = false;
    options.forEach(o => o.addEventListener('click', () => setView(o.dataset.viewOption!, true)));
    new ResizeObserver(syncIconOverlays).observe(list);
    window.addEventListener('load', syncIconOverlays);
  }
</script>
<script>
  import { matchTool } from '../lib/search.mjs';
  const input = document.querySelector<HTMLInputElement>('[data-search]');
  const rows = [...document.querySelectorAll<HTMLElement>('[data-tool]')];
  const ui = document.querySelector<HTMLElement>('[data-search-ui]');
  const countEl = document.querySelector<HTMLElement>('[data-result-count]')!;
  const headingEl = document.querySelector<HTMLElement>('[data-list-heading]');
  const emptySearch = document.querySelector<HTMLElement>('[data-empty]')!;
  const emptySaved = document.querySelector<HTMLElement>('[data-empty-saved]');
  const alternativeNote = document.querySelector<HTMLElement>('[data-alternative-note]');
  const alternativeNames = new Map(rows.map(row => [row, JSON.parse(row.dataset.alternativeNames ?? '[]')]));
  const baseHeading = headingEl?.textContent ?? '';
  const savedIds = () => {
    try {
      const v = JSON.parse(localStorage.getItem('foss-index:saved') || '[]');
      return Array.isArray(v) ? v : [];
    } catch { return []; }
  };
  const apply = () => {
    const query = input?.value ?? '';
    const matchedAlternatives = new Set<string>();
    const savedMode = location.hash === '#saved';
    const ids = savedMode ? savedIds() : [];
    let count = 0;
    for (const row of rows) {
      const match = matchTool(row.dataset.searchText!, alternativeNames.get(row)!, query);
      const show = match.matches && (!savedMode || ids.includes(row.dataset.toolId!));
      if (show && match.alternative) matchedAlternatives.add(match.alternative);
      row.hidden = !show;
      if (show) count++;
    }
    if (alternativeNote) {
      alternativeNote.hidden = matchedAlternatives.size === 0;
      alternativeNote.textContent = matchedAlternatives.size ? `Alternatives to explore for ${[...matchedAlternatives].join(', ')}. Features, compatibility and workflows differ.` : '';
    }
    countEl.textContent = savedMode ? `${count} saved` : `${count} ${count === 1 ? 'tool' : 'tools'}`;
    if (headingEl) headingEl.textContent = savedMode ? 'Saved tools' : baseHeading;
    emptySearch.hidden = (savedMode && ids.length === 0) || count !== 0;
    if (emptySaved) emptySaved.hidden = !(savedMode && ids.length === 0);
  };
  if (input && ui) {
    ui.hidden = false;
    input.addEventListener('input', apply);
    document.addEventListener('keydown', e => {
      if (e.key === '/' && !e.ctrlKey && !e.metaKey && !(e.target instanceof HTMLInputElement) && !(e.target instanceof HTMLTextAreaElement)) { e.preventDefault(); input.focus(); }
    });
  }
  window.addEventListener('hashchange', apply);
  document.addEventListener('foss-index:saved-changed', apply);
  apply();
</script>

---
interface Props { method: string; purpose: string; checkedOn: string; verification: string; text: string; }
const { method, purpose, checkedOn, verification, text } = Astro.props;
---
<section class="setup-prompt" data-setup-prompt data-method={method} aria-label={`${method} setup prompt`}>
  <div class="setup-prompt-heading"><strong>Ask your AI to help with setup · {method}</strong><button type="button" data-copy-setup hidden>Copy setup prompt</button></div>
  <p>{method} · {purpose}. Paste into your AI assistant. It may only be able to guide you. Review changes before running anything.</p>
  <p class="setup-prompt-check">{verification}. Checked {checkedOn}. No AI account or connection is needed here.</p>
  <details data-setup-fallback><summary>Read or copy the prompt manually</summary><label>Setup prompt for {method}<textarea readonly rows="10" spellcheck="false" data-setup-text>{text}</textarea></label></details>
  <p class="setup-prompt-status" role="status" aria-live="polite" data-setup-status></p>
</section>
<style>
  .setup-prompt { margin: 1.2rem 0 1.5rem; padding: 1rem; border: 1px solid var(--line, #c9c5b6); border-radius: 4px; }
  .setup-prompt-heading { display:flex; gap:.75rem; justify-content:space-between; align-items:center; flex-wrap:wrap; }
  .setup-prompt-heading strong { font-size:.95rem; }
  .setup-prompt p { font-size:.84rem; line-height:1.55; margin:.65rem 0 0; }
  .setup-prompt-check { opacity:.8; }
  .setup-prompt button { background:var(--ink, #293628); color:var(--paper, #f5f1e6); border:1px solid currentColor; border-radius:3px; padding:.55rem .7rem; font:inherit; font-size:.8rem; cursor:pointer; }
  .setup-prompt button:focus-visible, .setup-prompt summary:focus-visible, .setup-prompt textarea:focus-visible { outline:2px solid var(--rust, #aa5431); outline-offset:3px; }
  .setup-prompt details { margin-top:.7rem; font-size:.84rem; }
  .setup-prompt summary { cursor:pointer; }
  .setup-prompt label { display:block; margin-top:.7rem; }
  .setup-prompt textarea { box-sizing:border-box; width:100%; margin-top:.4rem; resize:vertical; background:var(--paper, #f5f1e6); color:var(--ink, #293628); border:1px solid var(--line, #c9c5b6); padding:.6rem; font: .78rem/1.5 monospace; }
  .setup-prompt-status:empty { display:none; }
  .setup-prompt [hidden] { display:none !important; }
</style>

---
import { slugify } from "../lib/catalog";
const { record } = Astro.props;
const serverRows = record.server?.platforms ?? [];
const clientRows = record.clients ?? [];
const flatRows = record.platforms ?? [];
const detailRows = record.server
  ? [...serverRows.map(row => ({ ...row, side: "server" })), ...clientRows.map(row => ({ ...row, side: "client" }))]
  : flatRows;
---
<section class="platform-support" aria-label={record.role === "operating-system" ? "Device compatibility" : "Platforms and clients"}>
  {record.server ? (
    <>
      <p class="eyebrow">Available on these platforms</p>
      {record.compatibilityUrl && <p class="privacy-note"><a href={record.compatibilityUrl}>Official hardware and installation choices ↗</a></p>}
      <div class="detail-meta">{clientRows.map(row => <a class="source-link" href={`${import.meta.env.BASE_URL}platform/${slugify(row.name)}/`}>{row.name}</a>)}</div>
      <p class="privacy-note">Requires {record.server.label}.</p>
    </>
  ) : (
    <>
      <p class="eyebrow">{record.role === "operating-system" ? "Device compatibility" : "Available on these platforms"}</p>
      {record.compatibilityUrl && <p class="privacy-note"><a href={record.compatibilityUrl}>Official hardware and installation choices ↗</a></p>}
      {flatRows.length > 0 && <div class="detail-meta">{flatRows.map(row => <a class="source-link" href={`${import.meta.env.BASE_URL}platform/${slugify(row.name)}/`}>{row.name}</a>)}</div>}
      {record.selfHost && <p class="privacy-note">Optional: <a href={record.selfHost.url}>{record.selfHost.label} ↗</a> - the app also works without your own server.</p>}
      <p class="privacy-note">{record.note}</p>
    </>
  )}
  <details class="privacy-note"><summary>{record.server ? "Server systems, compatibility details and official sources" : "Compatibility details and official sources"}</summary>
    {record.server && <p>{record.note}</p>}
    {record.details && <p>{record.details}</p>}
    <ul>{detailRows.map(row => <li><a href={row.url}>{row.name}</a>{row.side ? ` (${row.side})` : ""} - {row.kind}</li>)}</ul>
    <p>Official availability checked {record.checkedOn}. Availability is not feature parity. The recorded release and license refer to the linked source project; separate clients can differ. No install or compatibility test was run.</p>
  </details>
</section>

<style>.platform-support { margin: 1.25rem 0; } .access-line { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; }</style>

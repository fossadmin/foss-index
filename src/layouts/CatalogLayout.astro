---
import '../styles/custom.css';
import interRegular from '../assets/fonts/inter-latin-400-normal.woff2?url';
import { catalog } from '../lib/catalog';
const { groups, tools } = await catalog();
const { title = 'Discover open-source.', description = 'Discover open-source. Support the projects.', active = 'all' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width" />
    <title>{title} | FOSS Index</title><meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | FOSS Index`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://index.fossadmin.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://index.fossadmin.com/og-image.png" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
    <link rel="preload" href={interRegular} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="workspace">
      <aside class="rail">
        <a class="brand" href={base}><svg class="brand-mark" viewBox="0 0 200 200" aria-hidden="true" focusable="false"><rect x="22" y="22" width="156" height="156" rx="8" fill="none" stroke="var(--mark)" stroke-width="16"/><path d="M60 72 L96 100 L60 128" fill="none" stroke="var(--mark)" stroke-width="18"/><rect x="108" y="122" width="40" height="16" fill="#a15938"/></svg> FOSS Index</a>
        <button class="rail-menu" type="button" aria-label="Toggle navigation" aria-expanded="true" aria-controls="rail-collapse" hidden><svg class="menu-open" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" fill="none" stroke="currentColor" stroke-width="1.7"/></svg><svg class="menu-close" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19" fill="none" stroke="currentColor" stroke-width="1.7"/></svg></button>
        <p class="rail-intro">Good software.<br /> Yours to run.</p>
        <div class="rail-collapse" id="rail-collapse">
        <nav aria-label="Directory categories" class="category-nav">
          <p class="eyebrow">01 / Browse</p>
          <a class:list={['nav-item', { selected: active === 'all' }]} aria-current={active === 'all' ? 'page' : undefined} href={base} data-all-nav={active === 'all' ? '' : undefined}><span>All tools</span><span class="count">{tools.length}</span></a>
          <a class="nav-item" data-saved-nav href={`${base}#saved`} hidden><span>Saved</span><span class="count" data-saved-count>0</span></a>
          {groups.map(c => <a class:list={['nav-item', { selected: active === c.slug }]} aria-current={active === c.slug ? 'page' : undefined} href={`${base}browse/${c.slug}/`}><span>{c.name}</span><span class="count">{c.count}</span></a>)}
        </nav>
        <div class="rail-bottom">
          <p class="eyebrow">02 / The project</p>
          <nav aria-label="About the index"><a href={`${base}about/`}>About the index</a><a href={`${base}funding/`}>Funding, explained</a><a href={`${base}submit/`}>Submit a tool</a><a href={`${base}sponsor/`}>Sponsor the index</a><a href={`${base}about/#source-code-and-license`}>Source code and license</a></nav>
          <a class="parent-brand" href="https://fossadmin.com">A FOSSadmin project <span aria-hidden="true">↗</span></a>
          <p class="privacy-note">No analytics. No external scripts.</p>
        </div>
        </div>
      </aside>
      <div class="main-column">
        <header class="topbar"><a href={base} class="breadcrumb">~/foss-index</a><span class="edition">A small, growing directory</span><div class="theme-switcher" hidden>
          <input id="theme-switcher" type="checkbox" />
          <label for="theme-switcher">
            <span class="sr-only">Switch between light and dark mode</span>
            <span class="knob">
              <svg class="sun" viewBox="0 0 56 56" height="16" width="16" aria-hidden="true"><path d="M30 4.6c0-1-.9-2-2-2a2 2 0 0 0-2 2v5c0 1 .9 2 2 2s2-1 2-2Zm9.6 9a2 2 0 0 0 0 2.8c.8.8 2 .8 2.9 0L46 13a2 2 0 0 0 0-2.9 2 2 0 0 0-3 0Zm-26 2.8c.7.8 2 .8 2.8 0 .8-.7.8-2 0-2.9L13 10c-.7-.7-2-.8-2.9 0-.7.8-.7 2.1 0 3ZM28 16a12 12 0 0 0-12 12 12 12 0 0 0 12 12 12 12 0 0 0 12-12 12 12 0 0 0-12-12Zm23.3 14c1.1 0 2-.9 2-2s-.9-2-2-2h-4.9a2 2 0 0 0-2 2c0 1.1 1 2 2 2ZM4.7 26a2 2 0 0 0-2 2c0 1.1.9 2 2 2h4.9c1 0 2-.9 2-2s-1-2-2-2Zm37.8 13.6a2 2 0 0 0-3 0 2 2 0 0 0 0 2.9l3.6 3.5a2 2 0 0 0 2.9 0c.8-.8.8-2.1 0-3ZM10 43.1a2 2 0 0 0 0 2.9c.8.7 2.1.8 3 0l3.4-3.5c.8-.8.8-2.1 0-2.9-.8-.8-2-.8-2.9 0Zm20 3.4c0-1.1-.9-2-2-2a2 2 0 0 0-2 2v4.9c0 1 .9 2 2 2s2-1 2-2Z" /></svg>
              <svg class="moon" viewBox="0 0 24 24" height="16" width="16" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M8.2 2.2c1-.4 2 .6 1.6 1.5-1 3-.4 6.4 1.8 8.7a8.4 8.4 0 0 0 8.7 1.8c1-.3 2 .5 1.5 1.5v.1a10.3 10.3 0 0 1-9.4 6.2A10.3 10.3 0 0 1 3.2 6.7c1-2 2.9-3.5 4.9-4.4Z" /></svg>
            </span>
          </label>
        </div></header>
        <main id="main" tabindex="-1"><slot /></main>
        <footer class="page-footer"><span>Choose the tool. Keep control.</span><a href={`${base}funding/`}>Support the people who build it <span aria-hidden="true">↗</span></a></footer>
      </div>
    </div>
    <script is:inline>
      (function () {
        var sw = document.querySelector('.theme-switcher');
        if (!sw) return;
        var box = sw.querySelector('input');
        var root = document.documentElement;
        function current() {
          return root.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        }
        box.checked = current() === 'dark';
        sw.hidden = false;
        box.addEventListener('change', function () {
          var next = box.checked ? 'dark' : 'light';
          root.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch (e) {}
        });
      })();
    </script>
    <script is:inline>
      (function () {
        var KEY = 'foss-index:saved';
        function read() {
          try { var v = JSON.parse(localStorage.getItem(KEY) || '[]'); return Array.isArray(v) ? v : []; } catch (e) { return []; }
        }
        function write(ids) { try { localStorage.setItem(KEY, JSON.stringify(ids)); } catch (e) {} }
        function paint() {
          var ids = read();
          document.querySelectorAll('[data-save-toggle]').forEach(function (btn) {
            var on = ids.indexOf(btn.getAttribute('data-tool-id')) !== -1;
            btn.hidden = false;
            btn.classList.toggle('saved', on);
            btn.setAttribute('aria-pressed', on ? 'true' : 'false');
            var label = btn.querySelector('.save-label');
            if (label) label.textContent = on ? 'Saved' : 'Save';
          });
          document.querySelectorAll('[data-saved-count]').forEach(function (el) { el.textContent = String(ids.length); });
          document.dispatchEvent(new CustomEvent('foss-index:saved-changed', { detail: { ids: ids } }));
        }
        function syncNav() {
          var nav = document.querySelector('[data-saved-nav]');
          if (!nav) return;
          nav.hidden = false;
          var on = location.hash === '#saved';
          nav.classList.toggle('selected', on);
          if (on) nav.setAttribute('aria-current', 'page'); else nav.removeAttribute('aria-current');
          var all = document.querySelector('[data-all-nav]');
          if (all) {
            all.classList.toggle('selected', !on);
            if (on) all.removeAttribute('aria-current'); else all.setAttribute('aria-current', 'page');
          }
        }
        document.addEventListener('click', function (e) {
          var t = e.target;
          if (!(t instanceof Element)) return;
          var btn = t.closest('[data-save-toggle]');
          if (!btn) return;
          var id = btn.getAttribute('data-tool-id');
          var ids = read();
          var i = ids.indexOf(id);
          if (i === -1) ids.push(id); else ids.splice(i, 1);
          write(ids);
          paint();
        });
        window.addEventListener('hashchange', syncNav);
        paint();
        syncNav();
      })();
    </script>
    <script is:inline>
      (function () {
        var btn = document.querySelector('.rail-menu');
        var rail = document.querySelector('.rail');
        if (!btn || !rail) return;
        var mq = matchMedia('(max-width: 650px)');
        function apply() {
          if (mq.matches) {
            btn.hidden = false;
            rail.classList.add('collapsed');
            btn.setAttribute('aria-expanded', 'false');
          } else {
            btn.hidden = true;
            rail.classList.remove('collapsed');
            btn.setAttribute('aria-expanded', 'true');
          }
        }
        apply();
        mq.addEventListener('change', apply);
        btn.addEventListener('click', function () {
          var collapsed = rail.classList.toggle('collapsed');
          btn.setAttribute('aria-expanded', String(!collapsed));
        });
      })();
    </script>
  </body>
</html>
